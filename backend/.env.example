# ==========================================
# ArthaVest — Environment Variables Template
# Copy this file to .env and fill in your values.
# Never commit .env to git.
# ==========================================

# ── LLM (Amazon Bedrock) ──────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0   # optional override



# ── Database (Amazon Aurora PostgreSQL) ──
DATABASE_URL=postgresql://<user>:<password>@<aurora-cluster-endpoint>:5432/arthavest?sslmode=require

# ── Financial Data APIs ───────────────────
FRED_API_KEY=your_fred_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# ── App Settings ─────────────────────────
ENABLE_LOGS=True
SECRET_KEY=change_me_to_a_random_secret

# Backend base URL the frontend should call. Leave BLANK for the normal case
# (FastAPI serves the frontend, so it uses the same origin automatically).
# Set this only if you host the frontend on a different origin than the API,
# e.g. PUBLIC_API_BASE_URL=https://api.yourdomain.com
PUBLIC_API_BASE_URL=



# Disable the timestamped JSON dumper that writes to results/ on every API call.
# Defaults to false (no dumps). Set true only for debugging.
SAVE_RESULTS=false

# ── JWT Auth ──────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Deployment (Phase 4 — Agent Engine) ──
DEPLOYED=false

# ── MCP Data Server ──────────────────────
MCP_SERVER_URL=
MCP_TIMEOUT=45
MCP_RETRIES=2
DISABLE_MCP_FALLBACK=false
